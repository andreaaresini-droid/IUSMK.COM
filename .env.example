# ── Database (Supabase PostgreSQL — connection pooler) ──────────────────────
# Prendi da: Supabase Dashboard → Settings → Database → Connection string → Transaction pooler
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ── Auth JWT (usato solo per admin e student code-login) ────────────────────
JWT_SECRET=cambia-questo-in-produzione-32-caratteri-minimo
ADMIN_JWT_SECRET=cambia-questo-in-produzione-admin
VIDEO_JWT_SECRET=cambia-questo-in-produzione-video
PASSWORD_SALT=cambia-questo-in-produzione-salt

# ── Admin (hash SHA-256 della password admin) ───────────────────────────────
ADMIN_PASSWORD_HASH=

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase (frontend — prefisso VITE_) ────────────────────────────────────
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=

# ── SumUp ───────────────────────────────────────────────────────────────────
# Prendi da: SumUp Developer Dashboard → Credenziali OAuth
SUMUP_API_KEY=
SUMUP_MERCHANT_EMAIL=merchant@example.com
SUMUP_WEBHOOK_SECRET=

# ── AI ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@iusmk.com

# ── Deploy ──────────────────────────────────────────────────────────────────
VITE_API_URL=https://api.iusmk.com
